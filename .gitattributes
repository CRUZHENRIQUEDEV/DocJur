# --- Binary files ---
*.docx binary
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary

# --- Git LFS (opcional — instale LFS para ativar: https://git-lfs.com) ---
# Quando Git LFS estiver instalado, estes arquivos serao armazenados no LFS automaticamente:
*.docx filter=lfs diff=lfs merge=lfs -text
*.pdf filter=lfs diff=lfs merge=lfs -text
